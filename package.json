{
  "name": "orbitwright",
  "private": true,
  "version": "0.0.0",
  "description": "Orbitwright: a browser game about designing a space station, where the layout is the puzzle.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pixi.js": "^8.23.0"
  }
}
